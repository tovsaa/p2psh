# P2PSH server env vars. Copy to .env (gitignored) or pass via -e to docker/systemd.
# Defaults shown are the in-code defaults; lines marked (prod) are the hardened
# values we recommend for an internet-exposed deployment.

# --- identity & nym-client ---------------------------------------------------
# ML-KEM + Ed25519 keypair on disk. Persist this volume to keep your identity
# (and therefore the p2psh1:// connect string) stable across restarts.
P2PSH_IDENTITY=/data/server-identity.json

# Local nym-client native WebSocket. Default works when nym-client runs in the
# same container/host. Override only if you front it with a different port.
P2PSH_NYM_URL=ws://127.0.0.1:1977

# nym-client config id (used as $HOME/.nym/clients/<id>). Keep stable to
# preserve the mixnet gateway registration.
NYM_CLIENT_ID=p2psh

# --- shell hardening ---------------------------------------------------------
P2PSH_SHELL=bash
# P2PSH_SHELL_ARGS=-l

# (prod) Swap bash for rbash (restricted shell) on POSIX. Set to 1 unless you
# specifically need an unrestricted shell.
P2PSH_RESTRICT=1

# (prod) Spawn each session in a fresh mkdtemp $HOME that's wiped on
# disconnect. Prevents one peer's dotfiles from leaking into another's
# session. Set to 1.
P2PSH_EPHEMERAL_HOME=1

# (prod) Append a per-peer audit line for every keystroke frame. Path must be
# writable by the server process. Comment out to disable audit logging.
# P2PSH_AUDIT_LOG=/data/audit.log

# --- DoS limits --------------------------------------------------------------
# Hard cap on concurrent active peers. Past this, new hello/resume gets
# bad-request "server at capacity". Tune to your box's memory budget.
P2PSH_MAX_SESSIONS=32

# Sliding-window cap on hello+resume attempts per peer-address per minute.
# Lower = more aggressive throttling of bursty handshake spam.
P2PSH_RATE_PER_MIN=10

# --- transport allowlist -----------------------------------------------------
# Comma-separated list of data-plane transports the server will accept from
# clients: any | webrtc | nym | webrtc,nym
#
# (prod) Set to `nym` only if you don't want STUN-exposed peer IPs in your
# threat model. Default `any` lets each client pick.
P2PSH_TRANSPORT=any

# --- resume PFS policy (CLI client only) -------------------------------------
# How long a single resume chain may live before the client forces a full
# ML-KEM re-handshake, breaking forward dependence on the old key. Defaults:
# 24h chain age, 64 resumes per chain. Lower = stronger PFS, more handshake
# round-trips. The web client uses the same defaults but they are baked into
# the bundle (no env on the browser side).
# P2PSH_RESUME_MAX_AGE_MS=86400000
# P2PSH_RESUME_MAX_COUNT=64

# --- web client deep-link ----------------------------------------------------
# If set, the server also prints a ready-to-share deep link into the hosted
# web client on startup.
# P2PSH_WEB_URL=https://tovsaa.github.io/p2psh
